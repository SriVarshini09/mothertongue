# OpenAI API key (server-side only — never expose to the browser)
OPENAI_API_KEY=your_key_here

# Speech voice engine: "openai" (default, all languages) or "sarvam"
# (expressive Bulbul v3 voices for Indic languages + English).
# With "sarvam", unsupported languages automatically fall back to OpenAI.
SPEECH_PROVIDER=openai

# Optional: Sarvam API key (enables Sarvam Translate benchmark + Sarvam voices).
# Get one at https://dashboard.sarvam.ai — no key needed for the OpenAI path.
SARVAM_API_KEY=

# Optional: Hugging Face token for local IndicTrans2 / NLLB model downloads.
# Public checkpoints work without it; set it if downloads are rate-limited.
HF_TOKEN=
